<nav class="navbar is-primary is-fixed-top" role="navigation" aria-label="main navigation">
    <div class="navbar-brand">
        <a class="navbar-item" href="/">
            <i class="fas fa-hospital-alt mr-2"></i>
            <strong>PatientMS</strong>
        </a>
        <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarMain">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </a>
    </div>

    <div id="navbarMain" class="navbar-menu">
        <div class="navbar-start">
            {% if user %}
                <a class="navbar-item" href="/appointments">
                    <i class="fas fa-calendar-check mr-1"></i> Appointments
                </a>
                <a class="navbar-item" href="/appointments/calendar">
                    <i class="fas fa-calendar-alt mr-1"></i> Calendar
                </a>
                {% if user.role == "doctor" or user.role == "admin" %}
                <a class="navbar-item" href="/availability">
                    <i class="fas fa-clock mr-1"></i> Availability
                </a>
                <a class="navbar-item" href="/appointments/reassign-day">
                    <i class="fas fa-people-arrows mr-1"></i> Cover Leave
                </a>
                {% endif %}
                <a class="navbar-item" href="/records">
                    <i class="fas fa-notes-medical mr-1"></i> Medical Records
                </a>
                {% if user.role == "admin" %}
                <a class="navbar-item" href="/billing">
                    <i class="fas fa-file-invoice-dollar mr-1"></i> Billing
                </a>
                <a class="navbar-item" href="/users">
                    <i class="fas fa-users mr-1"></i> Users
                </a>
                <a class="navbar-item" href="/users/new">
                    <i class="fas fa-user-shield mr-1"></i> Add Staff
                </a>
                <a class="navbar-item" href="/dashboard">
                    <i class="fas fa-chart-line mr-1"></i> Dashboard
                </a>
                <a class="navbar-item" href="/audit">
                    <i class="fas fa-clipboard-list mr-1"></i> Audit
                </a>
                {% endif %}
                {% if user.role == "patient" %}
                <a class="navbar-item" href="/billing">
                    <i class="fas fa-receipt mr-1"></i> My Invoices
                </a>
                <a class="navbar-item" href="/records/timeline">
                    <i class="fas fa-stream mr-1"></i> My Timeline
                </a>
                {% endif %}
            {% endif %}
        </div>

        <div class="navbar-end">
            <div class="navbar-item">
                {% if user %}
                <div class="is-flex is-align-items-center">
                    <span class="mr-3 has-text-weight-semibold has-text-white">
                        <i class="fas fa-user-circle mr-1"></i>{{ user.username }}
                    </span>
                    {{ macros::user_role_tag(role=user.role, icon=false, size="mr-2") }}
                    <a class="button is-light is-small mr-1" href="/users/{{ user.user_id }}">
                        <i class="fas fa-id-card mr-1"></i>Profile
                    </a>
                    {# Logout is a POST (state-changing action), so it is a
                       form button rather than a link — see users::configure. #}
                    <form method="post" action="/users/logout">
                        <button class="button is-danger is-light is-small" type="submit">
                            <i class="fas fa-sign-out-alt mr-1"></i>Logout
                        </button>
                    </form>
                </div>
                {% else %}
                <div class="buttons">
                    <a class="button is-light" href="/users/register">
                        <i class="fas fa-user-plus mr-1"></i><strong>Register</strong>
                    </a>
                    <a class="button is-link" href="/users/login">
                        <i class="fas fa-sign-in-alt mr-1"></i>Login
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</nav>
