{% extends "base.html.tera" %}
{% import "shared/macros.html.tera" as macros %}

{% block content %}
<div class="level">
    <div class="level-left">
        <div>
            <h1 class="title"><i class="fas fa-file-invoice-dollar mr-2"></i>Billing</h1>
            <p class="subtitle is-6 has-text-grey">
                {% if user.role == "patient" %}Your invoices and payment history
                {% else %}Manage invoices, payments, and financial records{% endif %}
            </p>
        </div>
    </div>
    {% if user.role == "admin" %}
    <div class="level-right">
        <div class="buttons">
            <p class="button is-static has-text-grey"><i class="fas fa-file-invoice mr-1"></i>{{ invoices | length }}</p>
            <a class="button is-primary" href="/billing/create"><i class="fas fa-plus mr-1"></i>Create Invoice</a>
        </div>
    </div>
    {% endif %}
</div>

{% if invoices %}
<div class="table-container fade-in">
    <table class="table is-fullwidth is-striped is-hoverable">
        <thead>
            <tr>
                <th>ID</th>
                {% if user.role == "admin" %}<th>Patient</th>{% endif %}
                <th>Date</th>
                <th>Due Date</th>
                <th>Amount</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for inv in invoices %}
            <tr>
                <td>{{ inv.id }}</td>
                {% if user.role == "admin" %}<td>{{ inv.patient_name }}</td>{% endif %}
                <td>{{ inv.invoice_date }}</td>
                <td>{{ inv.due_date }}</td>
                <td>${{ inv.total_amount | round(precision=2) }}</td>
                <td>{{ macros::invoice_status_tag(status=inv.status) }}</td>
                <td><a class="button is-small is-info" href="/billing/{{ inv.id }}">View</a></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
    {% set action_href = "" %}
    {% if user.role == "admin" %}{% set action_href = "/billing/create" %}{% endif %}
    {% if user.role == "patient" %}
        {{ macros::empty_state(icon="fa-receipt", title="No Invoices Found", subtitle="You have no invoices yet.", action_href=action_href, action_label="Create Invoice") }}
    {% else %}
        {{ macros::empty_state(icon="fa-receipt", title="No Invoices Found", subtitle="Create the first invoice to get started.", action_href=action_href, action_label="Create Invoice") }}
    {% endif %}
{% endif %}
{% endblock %}
