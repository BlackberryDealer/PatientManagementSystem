{% extends "base.html.tera" %}
{% import "shared/macros.html.tera" as macros %}

{% block content %}
<nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li><a href="/billing"><i class="fas fa-file-invoice-dollar mr-1"></i>Billing</a></li>
        <li class="is-active"><a href="#" aria-current="page">#{{ invoice.id }}</a></li>
    </ul>
</nav>

<div class="box fade-in">
    <div class="is-flex is-align-items-center is-justify-content-space-between mb-5">
        <div>
            <h1 class="title mb-1">Invoice #{{ invoice.id }}</h1>
            <p class="subtitle is-6 has-text-grey">Issued: {{ invoice.invoice_date }}</p>
        </div>
        {{ macros::invoice_status_tag_header(status=invoice.status) }}
    </div>

    <div class="columns mt-4">
        <div class="column is-6">
            <div class="card card-equal-height">
                <header class="card-header has-background-light">
                    <p class="card-header-title">
                        <i class="fas fa-info-circle mr-2"></i>Invoice Details
                    </p>
                </header>
                <div class="card-content">
                    <p><strong>Patient ID:</strong> {{ invoice.patient_id }}</p>
                    <p><strong>Invoice Date:</strong> {{ invoice.invoice_date }}</p>
                    <p><strong>Due Date:</strong> {{ invoice.due_date }}</p>
                    <p><strong>Total:</strong> ${{ invoice.total_amount | round(precision=2) }}</p>
                    <p><strong>Status:</strong>
                        {{ macros::invoice_status_tag(status=invoice.status) }}
                    </p>
                </div>
            </div>
        </div>

        <div class="column is-6">
            <div class="card card-equal-height">
                <header class="card-header has-background-light">
                    <p class="card-header-title">
                        <i class="fas fa-list-ul mr-2"></i>Line Items
                    </p>
                </header>
                <div class="card-content">
                    {% if items %}
                    <table class="table is-fullwidth is-striped is-size-7">
                        <thead>
                            <tr><th>Description</th><th>Qty</th><th>Price</th><th>Total</th></tr>
                        </thead>
                        <tbody>
                            {% for item in items %}
                            <tr>
                                <td>{{ item.description }}</td>
                                <td>{{ item.quantity }}</td>
                                <td>${{ item.unit_price | round(precision=2) }}</td>
                                <td>${{ item.total_price | round(precision=2) }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="has-text-right">Total</th>
                                <th class="has-text-link">${{ invoice.total_amount }}</th>
                            </tr>
                        </tfoot>
                    </table>
                    {% else %}
                    <p class="has-text-grey"><i class="fas fa-info-circle mr-1"></i>No line items recorded.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Payments Section -->
    <div class="card mt-4">
        <header class="card-header has-background-info-light">
            <p class="card-header-title">
                <i class="fas fa-credit-card mr-2"></i>Payments
                <span class="tag is-info is-light ml-2">{{ payments | length }}</span>
            </p>
        </header>
        <div class="card-content">
            <!-- Payment progress summary -->
            <div class="mb-5">
                <div class="is-flex is-justify-content-space-between mb-2">
                    <span class="is-size-7 has-text-grey">PAID</span>
                    <span class="is-size-7 has-text-grey">REMAINING</span>
                </div>
                <progress class="progress is-medium
                    {% if invoice.status == 'paid' %}is-success
                    {% elif total_paid > 0 %}is-info
                    {% else %}is-warning{% endif %}"
                    value="{{ pct_paid | round }}" max="100">
                    {{ pct_paid | round }}%
                </progress>
                <div class="is-flex is-justify-content-space-between">
                    <span>
                        <span class="has-text-weight-bold has-text-info">£{{ total_paid | round(precision=2) | abs }}</span>
                        <span class="has-text-grey is-size-7"> / £{{ invoice.total_amount | round(precision=2) }}</span>
                    </span>
                    <span class="has-text-weight-bold {% if remaining > 0 %}has-text-danger{% else %}has-text-success{% endif %}">
                        {% if remaining > 0 %}£{{ remaining | round(precision=2) }}{% else %}£0.00{% endif %}
                    </span>
                </div>
            </div>

            {% if payments %}
            <table class="table is-fullwidth is-striped">
                <thead>
                    <tr><th>ID</th><th>Amount</th><th>Date</th><th>Method</th><th>Ref</th></tr>
                </thead>
                <tbody>
                    {% for p in payments %}
                    <tr>
                        <td>{{ p.id }}</td>
                        <td>${{ p.amount | round(precision=2) }}</td>
                        <td>{{ p.payment_date }}</td>
                        <td>{{ p.payment_method }}</td>
                        <td>{{ p.transaction_ref | default(value="—") }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <div class="has-text-centered py-4">
                <span class="icon is-medium has-text-grey-lighter"><i class="fas fa-credit-card fa-2x"></i></span>
                <p class="has-text-grey mt-2">No payments recorded yet.</p>
            </div>
            {% endif %}

            <!-- Record Payment Form -->
            {% if invoice.status == "pending" %}
            <hr>
            <h3 class="title is-5 mb-3"><i class="fas fa-plus-circle mr-1"></i>Record Payment</h3>
            <form method="POST" action="/billing/{{ invoice.id }}/pay">
                <div class="columns">
                    <div class="column">
                        <div class="field">
                            <label class="label">Amount ($)</label>
                            <div class="control has-icons-left">
                                <input class="input" type="number" step="0.01" name="amount" value="{{ invoice.total_amount }}" required>
                                <span class="icon is-small is-left"><i class="fas fa-dollar-sign"></i></span>
                            </div>
                        </div>
                    </div>
                    <div class="column">
                        <div class="field">
                            <label class="label">Payment Method</label>
                            <div class="control">
                                <div class="select is-fullwidth">
                                    <select name="payment_method" required>
                                        <option value="Credit Card">Credit Card</option>
                                        <option value="Cash">Cash</option>
                                        <option value="Bank Transfer">Bank Transfer</option>
                                        <option value="Insurance">Insurance</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="column">
                        <div class="field">
                            <label class="label">Reference <span class="has-text-grey">(optional)</span></label>
                            <div class="control has-icons-left">
                                <input class="input" type="text" name="transaction_ref" placeholder="e.g., TXN-001">
                                <span class="icon is-small is-left"><i class="fas fa-hashtag"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="field">
                    <div class="control">
                        <button class="button is-success" type="submit">
                            <i class="fas fa-check-circle mr-1"></i>Record Payment
                        </button>
                    </div>
                </div>
            </form>
            {% endif %}
        </div>
    </div>

    <div class="mt-5 is-flex is-justify-content-space-between">
        <a class="button is-light is-medium" href="/billing">
            <i class="fas fa-arrow-left mr-1"></i>Back to Billing
        </a>
        {% if invoice.status == "pending" and user.role == "admin" %}
        <form method="POST" action="/billing/{{ invoice.id }}/cancel">
            <button class="button is-danger is-light is-medium" type="submit"
                    onclick="return confirm('Cancel invoice #{{ invoice.id }}? This cannot be undone.');">
                <i class="fas fa-ban mr-1"></i>Cancel Invoice
            </button>
        </form>
        {% endif %}
    </div>
</div>
{% endblock %}
