{% extends "base.html.tera" %}

{% block content %}
<nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li><a href="/billing"><i class="fas fa-file-invoice-dollar mr-1"></i>Billing</a></li>
        <li class="is-active"><a href="#" aria-current="page">#{{ invoice.id }}</a></li>
    </ul>
</nav>

<div class="box fade-in">
    <div class="is-flex is-align-items-center is-justify-content-space-between mb-5">
        <div>
            <h1 class="title mb-1">Invoice #{{ invoice.id }}</h1>
            <p class="subtitle is-6 has-text-grey">Issued: {{ invoice.invoice_date }}</p>
        </div>
        <span class="tag is-medium
            {% if invoice.status == 'paid' %}is-success
            {% elif invoice.status == 'pending' %}is-warning
            {% else %}is-danger{% endif %} is-light">
            <i class="fas
                {% if invoice.status == 'paid' %}fa-check-circle
                {% elif invoice.status == 'pending' %}fa-clock
                {% else %}fa-ban{% endif %} mr-1"></i>
            <span style="text-transform: capitalize;">{{ invoice.status }}</span>
        </span>
    </div>

    <div class="columns mt-4">
        <div class="column is-6">
            <div class="card card-equal-height">
                <header class="card-header has-background-light">
                    <p class="card-header-title">
                        <i class="fas fa-info-circle mr-2"></i>Invoice Details
                    </p>
                </header>
                <div class="card-content">
                    <div class="mb-3">
                        <p class="is-size-7 has-text-grey mb-1">PATIENT</p>
                        <p class="has-text-weight-semibold"><i class="fas fa-user has-text-success mr-2"></i>Patient #{{ invoice.patient_id }}</p>
                    </div>
                    <div class="mb-3">
                        <p class="is-size-7 has-text-grey mb-1">DUE DATE</p>
                        <p class="has-text-weight-semibold"><i class="fas fa-calendar-alt has-text-warning mr-2"></i>{{ invoice.due_date }}</p>
                    </div>
                    <div>
                        <p class="is-size-7 has-text-grey mb-1">TOTAL AMOUNT</p>
                        <p class="is-size-4 has-text-weight-bold has-text-link">${{ invoice.total_amount }}</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="column is-6">
            <div class="card card-equal-height">
                <header class="card-header has-background-light">
                    <p class="card-header-title">
                        <i class="fas fa-list-ul mr-2"></i>Line Items
                    </p>
                </header>
                <div class="card-content">
                    {% if items %}
                    <table class="table is-fullwidth is-striped is-size-7">
                        <thead>
                            <tr><th>Description</th><th>Qty</th><th>Price</th><th>Total</th></tr>
                        </thead>
                        <tbody>
                            {% for item in items %}
                            <tr>
                                <td>{{ item.description }}</td>
                                <td>{{ item.quantity }}</td>
                                <td>${{ item.unit_price }}</td>
                                <td class="has-text-weight-semibold">${{ item.total_price }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="has-text-right">Total</th>
                                <th class="has-text-link">${{ invoice.total_amount }}</th>
                            </tr>
                        </tfoot>
                    </table>
                    {% else %}
                    <p class="has-text-grey"><i class="fas fa-info-circle mr-1"></i>No line items recorded.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Payments Section -->
    <div class="card mt-4">
        <header class="card-header has-background-info-light">
            <p class="card-header-title">
                <i class="fas fa-credit-card mr-2"></i>Payments
                <span class="tag is-info is-light ml-2">{{ payments | length }}</span>
            </p>
        </header>
        <div class="card-content">
            {% if payments %}
            <div class="table-container">
                <table class="table is-fullwidth is-striped is-hoverable">
                    <thead>
                        <tr>
                            <th><abbr title="Payment ID">#</abbr></th>
                            <th><i class="fas fa-dollar-sign mr-1"></i>Amount</th>
                            <th><i class="fas fa-calendar-alt mr-1"></i>Date</th>
                            <th>Method</th>
                            <th>Reference</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for p in payments %}
                        <tr>
                            <td class="has-text-grey is-size-7">#{{ p.id }}</td>
                            <td class="has-text-weight-semibold has-text-success">${{ p.amount }}</td>
                            <td class="is-size-7">{{ p.payment_date }}</td>
                            <td><span class="tag is-light">{{ p.payment_method }}</span></td>
                            <td class="is-size-7">{{ p.transaction_ref | default(value="—") }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="has-text-centered py-4">
                <span class="icon is-medium has-text-grey-lighter"><i class="fas fa-credit-card fa-2x"></i></span>
                <p class="has-text-grey mt-2">No payments recorded yet.</p>
            </div>
            {% endif %}

            <!-- Record Payment Form -->
            {% if invoice.status == "pending" %}
            <hr>
            <h3 class="title is-5 mb-3"><i class="fas fa-plus-circle mr-1"></i>Record Payment</h3>
            <form method="POST" action="/billing/{{ invoice.id }}/pay">
                <div class="columns">
                    <div class="column">
                        <div class="field">
                            <label class="label">Amount ($)</label>
                            <div class="control has-icons-left">
                                <input class="input" type="number" step="0.01" name="amount" value="{{ invoice.total_amount }}" required>
                                <span class="icon is-small is-left"><i class="fas fa-dollar-sign"></i></span>
                            </div>
                        </div>
                    </div>
                    <div class="column">
                        <div class="field">
                            <label class="label">Payment Method</label>
                            <div class="control">
                                <div class="select is-fullwidth">
                                    <select name="payment_method" required>
                                        <option value="Credit Card">Credit Card</option>
                                        <option value="Cash">Cash</option>
                                        <option value="Bank Transfer">Bank Transfer</option>
                                        <option value="Insurance">Insurance</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="column">
                        <div class="field">
                            <label class="label">Reference <span class="has-text-grey">(optional)</span></label>
                            <div class="control has-icons-left">
                                <input class="input" type="text" name="transaction_ref" placeholder="e.g., TXN-001">
                                <span class="icon is-small is-left"><i class="fas fa-hashtag"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="field">
                    <div class="control">
                        <button class="button is-success" type="submit">
                            <i class="fas fa-check-circle mr-1"></i>Record Payment
                        </button>
                    </div>
                </div>
            </form>
            {% endif %}
        </div>
    </div>

    <div class="mt-5">
        <a class="button is-light is-medium" href="/billing">
            <i class="fas fa-arrow-left mr-1"></i>Back to Billing
        </a>
    </div>
</div>
{% endblock %}
