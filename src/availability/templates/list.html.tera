{% extends "base.html.tera" %}

{% block content %}
<div class="level">
    <div class="level-left">
        <div>
            <h1 class="title"><i class="fas fa-clock mr-2"></i>Doctor Availability</h1>
            <p class="subtitle is-6 has-text-grey">Weekly recurring slots, blocked dates, and leave management</p>
        </div>
    </div>
    <div class="level-right">
        <div class="buttons">
            <p class="button is-static has-text-grey"><i class="fas fa-list mr-1"></i>{{ slots | length }}</p>
            <a class="button is-primary" href="/availability/set"><i class="fas fa-plus mr-1"></i>Set Availability</a>
        </div>
    </div>
</div>

{% if slots %}
<div class="table-container fade-in">
    <table class="table is-fullwidth is-striped is-hoverable">
        <thead>
            <tr>
                <th><abbr title="Slot ID">#</abbr></th>
                <th>Doctor</th>
                <th>Day</th>
                <th><i class="fas fa-clock mr-1"></i>Time</th>
                <th>Type</th>
                <th>Specific Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for s in slots %}
            {% set days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"] %}
            <tr>
                <td class="has-text-grey is-size-7">#{{ s.id }}</td>
                <td>
                    <span class="has-text-weight-semibold"><i class="fas fa-user-md has-text-info mr-1"></i>{{ s.doctor_name }}</span>
                </td>
                <td><span class="tag is-link is-light">{{ days[s.day_of_week] }}</span></td>
                <td>{{ s.start_time }} – {{ s.end_time }}</td>
                <td>
                    {% if s.is_recurring == 1 %}
                    <span class="tag is-info is-light"><i class="fas fa-redo mr-1"></i>Recurring</span>
                    {% else %}
                    <span class="tag is-warning is-light"><i class="fas fa-calendar-day mr-1"></i>One-off</span>
                    {% endif %}
                </td>
                <td>{{ s.specific_date | default(value="—") }}</td>
                <td>
                    {% if s.is_blocked == 1 %}
                    <span class="tag is-danger is-light"><i class="fas fa-lock mr-1"></i>Blocked</span>
                    {% else %}
                    <span class="tag is-success is-light"><i class="fas fa-check mr-1"></i>Available</span>
                    {% endif %}
                </td>
                <td>
                    <div class="buttons are-small">
                        <a class="button is-info is-light" href="/availability/{{ s.id }}/edit" title="Edit this slot">
                            <i class="fas fa-pen"></i>
                        </a>
                        <form method="POST" action="/availability/{{ s.id }}/delete"
                              onsubmit="return confirm('Delete this availability slot? Days left without published hours cannot be booked.');">
                            <button class="button is-danger is-light" type="submit" title="Delete this slot">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
<div class="hero is-medium has-text-centered has-text-grey fade-in">
    <div class="hero-body">
        <span class="icon is-large has-text-grey-lighter"><i class="fas fa-clock fa-4x"></i></span>
        <p class="title is-4 has-text-grey mt-4">No Availability Configured</p>
        <p class="subtitle is-6">Set your weekly working hours to start receiving appointments.</p>
        <a class="button is-primary mt-3" href="/availability/set"><i class="fas fa-plus mr-1"></i>Set Availability</a>
    </div>
</div>
{% endif %}
{% endblock %}
