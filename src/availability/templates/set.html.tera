{% extends "base.html.tera" %}

{% block content %}
<h1 class="title">Set Availability</h1>

<div class="box">
    <form method="POST" action="/availability/set">
        <div class="field">
            <label class="label">Day of Week</label>
            <div class="control">
                <div class="select is-fullwidth">
                    <select name="day_of_week" required>
                        <option value="0">Sunday</option>
                        <option value="1">Monday</option>
                        <option value="2">Tuesday</option>
                        <option value="3">Wednesday</option>
                        <option value="4">Thursday</option>
                        <option value="5">Friday</option>
                        <option value="6">Saturday</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="columns">
            <div class="column">
                <div class="field">
                    <label class="label">Start Time</label>
                    <div class="control">
                        <input class="input" type="time" name="start_time" required>
                    </div>
                </div>
            </div>
            <div class="column">
                <div class="field">
                    <label class="label">End Time</label>
                    <div class="control">
                        <input class="input" type="time" name="end_time" required>
                    </div>
                </div>
            </div>
        </div>

        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="is_recurring" value="on" checked>
                Recurring weekly
            </label>
        </div>

        <div class="field">
            <label class="label">Specific Date (optional — for one-off blocked dates)</label>
            <div class="control">
                <input class="input" type="date" name="specific_date">
            </div>
        </div>

        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="is_blocked" value="on">
                Block this slot (leave / unavailable)
            </label>
        </div>

        <div class="field">
            <div class="control">
                <button class="button is-primary" type="submit">Save Availability</button>
                <a class="button is-light" href="/availability">Cancel</a>
            </div>
        </div>
    </form>
</div>
{% endblock %}
