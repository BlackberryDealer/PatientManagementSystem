{% extends "base.html.tera" %}

{% block content %}
<nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li><a href="/appointments"><i class="fas fa-calendar-check mr-1"></i>Appointments</a></li>
        <li class="is-active"><a href="#" aria-current="page">Book</a></li>
    </ul>
</nav>

<h1 class="title"><i class="fas fa-plus-circle mr-2"></i>Book an Appointment</h1>
<p class="subtitle is-6 has-text-grey mb-5">Select a doctor, date, and time slot. The system will check for conflicts automatically.</p>

<div class="box fade-in">
    <form method="POST" action="/appointments/book">
        <div class="columns">
            <div class="column is-6">
                <div class="field">
                    <label class="label"><i class="fas fa-user-md mr-1"></i>Select Doctor</label>
                    <div class="control has-icons-left">
                        <div class="select is-fullwidth">
                            <select name="doctor_id" required>
                                <option value="">-- Choose a doctor --</option>
                                {% for d in doctors %}
                                <option value="{{ d.0 }}">{{ d.1 }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="icon is-small is-left"><i class="fas fa-user-md"></i></div>
                    </div>
                    <p class="help">Available doctors registered in the system.</p>
                </div>

                <div class="field">
                    <label class="label"><i class="fas fa-calendar-alt mr-1"></i>Appointment Date</label>
                    <div class="control">
                        <input class="input" type="date" name="appointment_date" required
                               min="2026-01-01" placeholder="YYYY-MM-DD">
                    </div>
                    <p class="help">Select a future date. Weekend availability depends on the doctor's schedule.</p>
                </div>
            </div>

            <div class="column is-6">
                <div class="notification is-info is-light">
                    <p><i class="fas fa-info-circle mr-1"></i><strong>Conflict Detection Active</strong></p>
                    <p class="is-size-7 mt-1">The system prevents double-booking by checking for overlapping appointments. If the slot is already taken, you'll be asked to pick a different time.</p>
                </div>
            </div>
        </div>

        <div class="columns">
            <div class="column is-6">
                <div class="field">
                    <label class="label"><i class="fas fa-clock mr-1"></i>Start Time</label>
                    <div class="control">
                        <input class="input" type="time" name="start_time" required>
                    </div>
                </div>
            </div>
            <div class="column is-6">
                <div class="field">
                    <label class="label"><i class="fas fa-clock mr-1"></i>End Time</label>
                    <div class="control">
                        <input class="input" type="time" name="end_time" required>
                    </div>
                    <p class="help">End time must be after start time.</p>
                </div>
            </div>
        </div>

        <div class="field">
            <label class="label"><i class="fas fa-pencil-alt mr-1"></i>Notes <span class="has-text-grey is-size-7">(optional)</span></label>
            <div class="control">
                <textarea class="textarea" name="notes" placeholder="Reason for visit, symptoms, or special requests..." rows="3"></textarea>
            </div>
        </div>

        <hr>

        <div class="columns">
            <div class="column is-6">
                <div class="field">
                    <label class="label"><i class="fas fa-door-open mr-1"></i>Room <span class="has-text-grey">(optional)</span></label>
                    <div class="control">
                        <div class="select is-fullwidth">
                            <select name="room_id">
                                <option value="">-- No specific room --</option>
                                {% for r in rooms %}
                                <option value="{{ r.id }}">{{ r.name }} ({{ r.room_type }})</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <p class="help">Assign a consultation room. Room conflicts are also checked.</p>
                </div>
            </div>
            <div class="column is-6">
                <div class="field">
                    <label class="label"><i class="fas fa-flag mr-1"></i>Priority</label>
                    <div class="control">
                        <div class="select is-fullwidth">
                            <select name="priority">
                                <option value="3" selected>Normal (Standard)</option>
                                <option value="4">Follow-up</option>
                                <option value="2">Urgent</option>
                                <option value="1">Emergency</option>
                            </select>
                        </div>
                    </div>
                    <p class="help">Emergency/Urgent bookings can bump lower-priority appointments to the waitlist.</p>
                </div>
            </div>
        </div>

        <div class="field">
            <label class="label"><i class="fas fa-pencil-alt mr-1"></i>Notes <span class="has-text-grey is-size-7">(optional)</span></label>
            <div class="control">
                <textarea class="textarea" name="notes" placeholder="Reason for visit, symptoms, or special requests..." rows="3"></textarea>
            </div>
        </div>

        <hr>

        <div class="field is-grouped">
            <div class="control">
                <button class="button is-primary is-medium" type="submit" formaction="/appointments/book">
                    <i class="fas fa-check-circle mr-1"></i>Book (Standard)
                </button>
            </div>
            <div class="control">
                <button class="button is-danger is-medium" type="submit" formaction="/appointments/book/priority"
                        title="If slot is taken by a lower-priority appointment, it will be bumped">
                    <i class="fas fa-star mr-1"></i>Book (Priority Override)
                </button>
            </div>
            <div class="control">
                <a class="button is-light is-medium" href="/appointments">
                    <i class="fas fa-times mr-1"></i>Cancel
                </a>
            </div>
            <div class="control">
                <a class="button is-info is-light is-medium" href="/appointments/suggest">
                    <i class="fas fa-search mr-1"></i>Find Available Slot
                </a>
            </div>
        </div>
    </form>
</div>
{% endblock %}
