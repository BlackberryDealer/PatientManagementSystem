{% extends "base.html.tera" %}

{% block content %}
<nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li><a href="/appointments"><i class="fas fa-calendar-check mr-1"></i>Appointments</a></li>
        <li class="is-active"><a href="#" aria-current="page">Book</a></li>
    </ul>
</nav>

<h1 class="title"><i class="fas fa-plus-circle mr-2"></i>Book an Appointment</h1>
<p class="subtitle is-6 has-text-grey mb-5">
    {% if user.role == "patient" %}Select a doctor, date, and time slot. The system will check for conflicts automatically.
    {% elif user.role == "doctor" %}Book a patient into your own schedule. The system will check for conflicts automatically.
    {% else %}Book on a patient's behalf with any doctor. The system will check for conflicts automatically.{% endif %}
</p>

<div class="box fade-in">
    <form method="POST" action="/appointments/book">
        <div class="columns">
            <div class="column is-6">
                {% if user.role == "doctor" or user.role == "admin" %}
                <div class="field">
                    <label class="label"><i class="fas fa-user mr-1"></i>Select Patient</label>
                    <div class="control has-icons-left">
                        <div class="select is-fullwidth">
                            <select name="patient_id" required>
                                <option value="">-- Choose a patient --</option>
                                {% for p in patients %}
                                <option value="{{ p.0 }}">{{ p.1 }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="icon is-small is-left"><i class="fas fa-user"></i></div>
                    </div>
                    <p class="help">The patient this appointment is for.</p>
                </div>
                {% endif %}

                {% if user.role == "patient" or user.role == "admin" %}
                <div class="field">
                    <label class="label"><i class="fas fa-user-md mr-1"></i>Select Doctor</label>
                    <div class="control has-icons-left">
                        <div class="select is-fullwidth">
                            <select name="doctor_id" required>
                                <option value="">-- Choose a doctor --</option>
                                {% for d in doctors %}
                                <option value="{{ d.0 }}">{{ d.1 }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="icon is-small is-left"><i class="fas fa-user-md"></i></div>
                    </div>
                    <p class="help">Available doctors registered in the system.</p>
                </div>
                {% endif %}

                <div class="field">
                    <label class="label"><i class="fas fa-calendar-alt mr-1"></i>Appointment Date</label>
                    <div class="control">
                        <input class="input" type="date" name="appointment_date" required
                               min="2026-01-01" placeholder="YYYY-MM-DD">
                    </div>
                    <p class="help">Select a future date. Weekend availability depends on the doctor's schedule.</p>
                </div>
            </div>

            <div class="column is-6">
                <div class="notification is-info is-light">
                    <p><i class="fas fa-info-circle mr-1"></i><strong>Auto-Assigned Room</strong></p>
                    <p class="is-size-7 mt-1">A room is automatically assigned from the doctor's daily allocation. The system prevents double-booking by checking for overlapping appointments.</p>
                </div>
                {% if user.role == "doctor" %}
                <div class="notification is-light">
                    <p><i class="fas fa-user-md mr-1"></i><strong>Your Schedule</strong></p>
                    <p class="is-size-7 mt-1">This appointment will be booked into your own schedule. To move an existing visit to a colleague, use <em>Reassign Doctor</em> on the appointment page instead.</p>
                </div>
                {% endif %}
            </div>
        </div>

        <div class="columns">
            <div class="column is-6">
                <div class="field">
                    <label class="label"><i class="fas fa-clock mr-1"></i>Start Time</label>
                    <div class="control has-icons-left">
                        <div class="select is-fullwidth">
                            <select name="start_time" required>
                                <option value="">-- Select start --</option>
                                {% for s in start_slots %}
                                <option value="{{ s }}">{{ s }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="icon is-small is-left"><i class="fas fa-clock"></i></div>
                    </div>
                </div>
            </div>
            <div class="column is-6">
                <div class="field">
                    <label class="label"><i class="fas fa-clock mr-1"></i>End Time</label>
                    <div class="control has-icons-left">
                        <div class="select is-fullwidth">
                            <select name="end_time" required>
                                <option value="">-- Select end --</option>
                                {% for e in end_slots %}
                                <option value="{{ e }}">{{ e }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="icon is-small is-left"><i class="fas fa-clock"></i></div>
                    </div>
                    <p class="help">Appointments are booked in fixed 30-minute blocks. Pick a start and end on the grid.</p>
                </div>
            </div>
        </div>

        <div class="field">
            <label class="label"><i class="fas fa-pencil-alt mr-1"></i>Notes <span class="has-text-grey is-size-7">(optional)</span></label>
            <div class="control">
                <textarea class="textarea" name="notes" placeholder="Reason for visit, symptoms, or special requests..." rows="3"></textarea>
            </div>
        </div>

        {# Priority is a triage decision, so it is shown only to staff
           (doctor/admin). A patient's form omits the field entirely — the
           server forces patient bookings to Normal regardless. #}
        {% if user.role == "doctor" or user.role == "admin" %}
        <hr>

        <div class="columns">
            <div class="column is-6">
                <div class="field">
                    <label class="label"><i class="fas fa-flag mr-1"></i>Priority</label>
                    <div class="control">
                        <div class="select is-fullwidth">
                            <select name="priority">
                                <option value="3" selected>Normal (Standard)</option>
                                <option value="4">Follow-up</option>
                                <option value="2">Urgent</option>
                                <option value="1">Emergency</option>
                            </select>
                        </div>
                    </div>
                    <p class="help">If the slot is taken, an Emergency/Urgent booking automatically bumps lower-priority appointments to the waitlist.</p>
                </div>
            </div>
        </div>
        {% endif %}

        <hr>

        <div class="field is-grouped">
            <div class="control">
                <button class="button is-primary is-medium" type="submit">
                    <i class="fas fa-check-circle mr-1"></i>Book Appointment
                </button>
            </div>
            <div class="control">
                <a class="button is-light is-medium" href="/appointments">
                    <i class="fas fa-times mr-1"></i>Cancel
                </a>
            </div>
            <div class="control">
                <a class="button is-info is-light is-medium" href="/appointments/suggest">
                    <i class="fas fa-search mr-1"></i>Find Available Slot
                </a>
            </div>
        </div>
    </form>
</div>
{% endblock %}

{% block scripts %}
<script>
    // Progressive enhancement: when a start slot is chosen, default the end
    // slot to 30 minutes later. Works without JS too — both dropdowns only
    // contain grid-aligned times and the server validates start < end.
    (function () {
        const start = document.querySelector('select[name="start_time"]');
        const end = document.querySelector('select[name="end_time"]');
        if (!start || !end) return;
        start.addEventListener('change', function () {
            if (!start.value) return;
            const [h, m] = start.value.split(':').map(Number);
            const next = h * 60 + m + 30;
            const target = String(Math.floor(next / 60)).padStart(2, '0') + ':' + String(next % 60).padStart(2, '0');
            if (!end.value || end.value <= start.value) {
                for (const opt of end.options) {
                    if (opt.value === target) { end.value = target; break; }
                }
            }
        });
    })();
</script>
{% endblock %}
