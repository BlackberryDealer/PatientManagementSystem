{% extends "base.html.tera" %}

{% block head_extra %}
<style>
    /* Calendar grid cell sizing, page-specific so it lives here rather than
       in the shared base stylesheet. The fixed 80px/14.28% grid is legible
       on tablet and up; below 480px it shrinks so a week still fits the
       screen width instead of forcing horizontal scroll. */
    .cal-cell { height: 80px; width: 14.28%; vertical-align: top; padding: 6px; }
    .cal-cell.is-other-month { opacity: 0.3; }
    .cal-cell.is-today-cell { background-color: #e8f4fd; }
    .cal-day-link { text-decoration: none; font-weight: normal; color: inherit; }
    .cal-day-link.is-today-link { font-weight: bold; color: #3273dc; }

    @media (max-width: 480px) {
        .cal-cell { height: 44px; padding: 2px; font-size: 0.75rem; }
        .cal-day-link { font-size: 0.85rem; }
    }
</style>
{% endblock %}

{% block content %}
<div class="level">
    <div class="level-left">
        <h1 class="title"><i class="fas fa-calendar-alt mr-2"></i>{{ month_name }} {{ year }}</h1>
    </div>
    <div class="level-right">
        <div class="buttons">
            <a class="button is-light" href="/appointments/calendar?year={{ prev_year }}&month={{ prev_month }}">
                <i class="fas fa-chevron-left"></i>
            </a>
            <a class="button is-primary" href="/appointments/book">
                <i class="fas fa-plus mr-1"></i>Book
            </a>
            <a class="button is-light" href="/appointments/calendar?year={{ next_year }}&month={{ next_month }}">
                <i class="fas fa-chevron-right"></i>
            </a>
        </div>
    </div>
</div>

<div class="box fade-in">
    <div class="table-container">
    <table class="table is-fullwidth is-bordered">
        <thead>
            <tr>
                <th class="has-text-centered has-background-light">Mon</th>
                <th class="has-text-centered has-background-light">Tue</th>
                <th class="has-text-centered has-background-light">Wed</th>
                <th class="has-text-centered has-background-light">Thu</th>
                <th class="has-text-centered has-background-light">Fri</th>
                <th class="has-text-centered has-background-light">Sat</th>
                <th class="has-text-centered has-background-light">Sun</th>
            </tr>
        </thead>
        <tbody>
            {% for week in weeks %}
            <tr>
                {% for day in week %}
                <td class="has-text-centered cal-cell
                    {% if not day.is_current_month %}is-other-month{% endif %}
                    {% if day.is_today %}is-today-cell{% endif %}">
                    {% if day.day > 0 %}
                    <a href="/appointments?date={{ day.date }}"
                       class="cal-day-link {% if day.is_today %}is-today-link{% endif %}">
                        {{ day.day }}
                    </a>
                    {% if day.count > 0 %}
                    <br>
                    <span class="tag is-primary is-light is-small mt-1">{{ day.count }}</span>
                    {% endif %}
                    {% else %}
                    &nbsp;
                    {% endif %}
                </td>
                {% endfor %}
            </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>

<div class="has-text-centered">
    <a class="button is-light" href="/appointments">
        <i class="fas fa-list mr-1"></i>List View
    </a>
</div>
{% endblock %}
