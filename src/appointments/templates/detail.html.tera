{% extends "base.html.tera" %}

{% block content %}
<nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li><a href="/appointments"><i class="fas fa-calendar-check mr-1"></i>Appointments</a></li>
        <li class="is-active"><a href="#" aria-current="page">#{{ appointment.id }}</a></li>
    </ul>
</nav>

<div class="box fade-in">
    <div class="is-flex is-align-items-center is-justify-content-space-between mb-5">
        <div>
            <h1 class="title mb-2">Appointment #{{ appointment.id }}</h1>
            {# Plain sized text, not Bulma `.subtitle`: a `.subtitle` directly
               after a `.title` gets a -1.5rem top margin, which pulled the date
               up into the heading and overlapped it. #}
            <p class="is-size-6 has-text-grey">{{ appointment.appointment_date }}</p>
        </div>
        <span class="tag is-medium
            {% if appointment.status == 'scheduled' %}is-primary
            {% elif appointment.status == 'completed' %}is-success
            {% else %}is-danger{% endif %} is-light">
            <i class="fas
                {% if appointment.status == 'scheduled' %}fa-hourglass-half
                {% elif appointment.status == 'completed' %}fa-check-circle
                {% else %}fa-times-circle{% endif %} mr-1"></i>
            <span style="text-transform: capitalize;">{{ appointment.status }}</span>
        </span>
    </div>

    <div class="columns mt-4">
        <div class="column is-6">
            <div class="card card-equal-height">
                <header class="card-header has-background-light">
                    <p class="card-header-title">
                        <i class="fas fa-info-circle mr-2"></i>Appointment Details
                    </p>
                </header>
                <div class="card-content">
                    <div class="mb-4">
                        <p class="is-size-7 has-text-grey mb-1">DATE</p>
                        <p class="is-size-5 has-text-weight-semibold"><i class="fas fa-calendar-alt mr-2 has-text-link"></i>{{ appointment.appointment_date }}</p>
                    </div>
                    <div class="mb-4">
                        <p class="is-size-7 has-text-grey mb-1">TIME</p>
                        <p class="is-size-5 has-text-weight-semibold"><i class="fas fa-clock mr-2 has-text-link"></i>{{ appointment.start_time }} – {{ appointment.end_time }}</p>
                    </div>
                    <div class="mb-4">
                        <p class="is-size-7 has-text-grey mb-1">ROOM</p>
                        <p class="is-size-5 has-text-weight-semibold">
                            <i class="fas fa-door-open mr-2 has-text-link"></i>{% if appointment.room_name %}{{ appointment.room_name }}{% else %}Auto-Assigned{% endif %}
                        </p>
                        {% if appointment.status == "scheduled" and (user.role == "doctor" or user.role == "admin") and rooms %}
                        <form method="POST" action="/appointments/{{ appointment.id }}/assign-room" class="mt-2">
                            <div class="field has-addons">
                                <div class="control">
                                    <div class="select is-small">
                                        <select name="room_id">
                                            {% for r in rooms %}
                                            <option value="{{ r.id }}">{{ r.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                                <div class="control">
                                    <button class="button is-small is-link is-light" type="submit">
                                        <i class="fas fa-right-left mr-1"></i>Change Room
                                    </button>
                                </div>
                            </div>
                        </form>
                        {% endif %}
                    </div>
                    <div class="mb-4">
                        <p class="is-size-7 has-text-grey mb-1">PRIORITY</p>
                        <p class="is-size-5">
                            {% if appointment.priority == 1 %}
                            <span class="tag is-danger is-medium"><i class="fas fa-exclamation-triangle mr-1"></i>Emergency</span>
                            {% elif appointment.priority == 2 %}
                            <span class="tag is-warning is-medium"><i class="fas fa-exclamation-circle mr-1"></i>Urgent</span>
                            {% elif appointment.priority == 4 %}
                            <span class="tag is-success is-medium"><i class="fas fa-rotate-right mr-1"></i>Follow-up</span>
                            {% else %}
                            <span class="tag is-info is-medium"><i class="fas fa-flag mr-1"></i>Normal</span>
                            {% endif %}
                        </p>
                        {% if appointment.status == "scheduled" and (user.role == "doctor" or user.role == "admin") %}
                        <form method="POST" action="/appointments/{{ appointment.id }}/priority" class="mt-2">
                            <div class="field has-addons">
                                <div class="control">
                                    <div class="select is-small">
                                        <select name="priority">
                                            <option value="1" {% if appointment.priority == 1 %}selected{% endif %}>Emergency</option>
                                            <option value="2" {% if appointment.priority == 2 %}selected{% endif %}>Urgent</option>
                                            <option value="3" {% if appointment.priority == 3 %}selected{% endif %}>Normal</option>
                                            <option value="4" {% if appointment.priority == 4 %}selected{% endif %}>Follow-up</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="control">
                                    <button class="button is-small is-link is-light" type="submit">
                                        <i class="fas fa-flag mr-1"></i>Change Priority
                                    </button>
                                </div>
                            </div>
                        </form>
                        {% endif %}
                    </div>
                    {% if appointment.notes %}
                    <div>
                        <p class="is-size-7 has-text-grey mb-1">NOTES</p>
                        <div class="notification is-light">{{ appointment.notes }}</div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="column is-6">
            <div class="card card-equal-height">
                <header class="card-header has-background-info-light">
                    <p class="card-header-title">
                        <i class="fas fa-users mr-2"></i>Participants
                    </p>
                </header>
                <div class="card-content">
                    <div class="mb-5">
                        <p class="is-size-7 has-text-grey mb-2">PATIENT</p>
                        <div class="media">
                            <div class="media-left">
                                <span class="icon is-medium has-text-success"><i class="fas fa-user-circle fa-2x"></i></span>
                            </div>
                            <div class="media-content">
                                <p class="is-size-5 has-text-weight-semibold">{{ appointment.patient_name }}</p>
                            </div>
                        </div>
                    </div>
                    <div>
                        <p class="is-size-7 has-text-grey mb-2">DOCTOR</p>
                        <div class="media">
                            <div class="media-left">
                                <span class="icon is-medium has-text-info"><i class="fas fa-user-md fa-2x"></i></span>
                            </div>
                            <div class="media-content">
                                <p class="is-size-5 has-text-weight-semibold">{{ appointment.doctor_name }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 is-flex is-align-items-center" style="gap: 0.75rem;">
        <a class="button is-light" href="/appointments">
            <i class="fas fa-arrow-left mr-1"></i>Back to Appointments
        </a>
        {% if appointment.status == "scheduled" %}
        <a class="button is-info is-light" href="/appointments/{{ appointment.id }}/reschedule">
            <i class="fas fa-clock-rotate-left mr-1"></i>Reschedule
        </a>
        <form method="POST" action="/appointments/{{ appointment.id }}/cancel" style="display:inline;">
            <button class="button is-danger is-light" type="submit" onclick="return confirm('Cancel appointment #{{ appointment.id }}? This cannot be undone.')">
                <i class="fas fa-ban mr-1"></i>Cancel Appointment
            </button>
        </form>
        {% if user.role == "doctor" or user.role == "admin" %}
        <form method="POST" action="/appointments/{{ appointment.id }}/complete" style="display:inline;">
            <button class="button is-success" type="submit" onclick="return confirm('Mark appointment #{{ appointment.id }} as completed?')">
                <i class="fas fa-check mr-1"></i>Mark Completed
            </button>
        </form>
        <form method="POST" action="/appointments/{{ appointment.id }}/reassign" style="display:inline;">
            <button class="button is-warning is-light" type="submit" onclick="return confirm('Reassign appointment #{{ appointment.id }} to the best available doctor?')">
                <i class="fas fa-exchange-alt mr-1"></i>Reassign Doctor
            </button>
        </form>
        <a class="button is-success is-light" href="/records/create?patient_id={{ appointment.patient_id }}&appointment_id={{ appointment.id }}">
            <i class="fas fa-file-medical mr-1"></i>Create Medical Record
        </a>
        {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}
