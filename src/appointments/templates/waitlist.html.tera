{% extends "base.html.tera" %}
{% import "shared/macros.html.tera" as macros %}

{% block content %}
<nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li><a href="/appointments"><i class="fas fa-calendar-check mr-1"></i>Appointments</a></li>
        <li class="is-active"><a href="#" aria-current="page">Waitlist</a></li>
    </ul>
</nav>

<h1 class="title"><i class="fas fa-list-ol mr-2"></i>{{ doctor_label | default(value="Waitlist") }}</h1>
<p class="subtitle is-6 has-text-grey mb-5">
    Patients waiting for appointment slots. Ordered by priority — Emergency patients are served first.
</p>

{# One-time notice when a promotion could not proceed (e.g. the slot is held by
   an equal or higher priority appointment). Passed through the URL by the
   promote handler; Tera auto-escapes it. #}
{% if error %}
<div class="notification is-warning is-light fade-in">
    <i class="fas fa-exclamation-triangle mr-1"></i>{{ error }}
</div>
{% endif %}

{% if waitlist %}
<div class="table-container fade-in">
    <table class="table is-fullwidth is-striped is-hoverable">
        <thead>
            <tr>
                <th><abbr title="Position">#</abbr></th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Date</th>
                <th>Time</th>
                <th>Priority</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for w in waitlist %}
            <tr>
                <td class="has-text-grey is-size-7">#{{ w.id }}</td>
                <td>
                    <span class="has-text-weight-semibold"><i class="fas fa-user has-text-success mr-1"></i>{{ w.patient_name }}</span>
                </td>
                <td>
                    <span class="has-text-weight-semibold"><i class="fas fa-user-md has-text-info mr-1"></i>{{ w.doctor_name }}</span>
                </td>
                <td>{{ w.appointment_date }}</td>
                <td>{{ w.requested_start }} – {{ w.requested_end }}</td>
                <td>
                    {% if w.priority == 1 %}
                    <span class="tag is-danger is-light"><i class="fas fa-ambulance mr-1"></i>Emergency</span>
                    {% elif w.priority == 2 %}
                    <span class="tag is-warning is-light"><i class="fas fa-exclamation-triangle mr-1"></i>Urgent</span>
                    {% elif w.priority == 4 %}
                    <span class="tag is-success is-light"><i class="fas fa-redo mr-1"></i>Follow-up</span>
                    {% else %}
                    <span class="tag is-info is-light"><i class="fas fa-clock mr-1"></i>Normal</span>
                    {% endif %}
                </td>
                <td>
                    {{ macros::waitlist_status_tag(status=w.status) }}
                    {% if w.status == "expired" %}
                    <p class="is-size-7 has-text-grey mt-1">This request expired before a slot opened. You can book a new appointment from the booking page.</p>
                    {% endif %}
                </td>
                <td>
                    {# Promotion is a staff decision — patients see their
                       queue position but cannot promote themselves. #}
                    {% if w.status == "waiting" and (user.role == "doctor" or user.role == "admin") %}
                    <form method="POST" action="/appointments/waitlist/{{ w.id }}/promote" style="display:inline;">
                        <button class="button is-small is-success is-light" type="submit"
                                title="Book this patient into the slot. If it is taken by a lower-priority appointment, that one is bumped to the waitlist.">
                            <i class="fas fa-arrow-up mr-1"></i>Promote
                        </button>
                    </form>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
    {{ macros::empty_state(icon="fa-clipboard-list", title="Waitlist Empty", subtitle="No patients are currently waiting for slots.") }}
{% endif %}

{# Patients can queue for a slot that is currently taken. Priority is not
   asked for — the server files every patient-joined entry as Normal, since
   triage is a clinical decision. #}
{% if user.role == "patient" %}
<div class="box mt-5">
    <h2 class="title is-5"><i class="fas fa-plus-circle mr-2"></i>Join the Waitlist</h2>
    <p class="is-size-7 has-text-grey mb-4">Want a time that is fully booked? Queue for it here — if the slot frees up, the clinic promotes waiting patients in order.</p>
    <form method="POST" action="/appointments/waitlist/join">
        <div class="columns">
            <div class="column is-3">
                <div class="field">
                    <label class="label is-small">Doctor</label>
                    <div class="control">
                        <div class="select is-fullwidth is-small">
                            <select name="doctor_id" required>
                                <option value="">-- Choose a doctor --</option>
                                {% for d in doctors %}
                                <option value="{{ d.0 }}">{{ d.1 }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="column is-3">
                <div class="field">
                    <label class="label is-small">Date</label>
                    <div class="control">
                        <input class="input is-small" type="date" name="appointment_date" required>
                    </div>
                </div>
            </div>
            <div class="column is-2">
                <div class="field">
                    <label class="label is-small">From</label>
                    <div class="control">
                        <div class="select is-fullwidth is-small">
                            <select name="requested_start" required>
                                {% for s in start_slots %}
                                <option value="{{ s }}">{{ s }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="column is-2">
                <div class="field">
                    <label class="label is-small">To</label>
                    <div class="control">
                        <div class="select is-fullwidth is-small">
                            <select name="requested_end" required>
                                {% for e in end_slots %}
                                <option value="{{ e }}">{{ e }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="column is-2">
                <div class="field">
                    <label class="label is-small">&nbsp;</label>
                    <div class="control">
                        <button class="button is-primary is-small is-fullwidth" type="submit">
                            <i class="fas fa-list-ol mr-1"></i>Join Waitlist
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <input type="hidden" name="priority" value="3">
        <div class="field">
            <label class="label is-small">Notes <span class="has-text-grey">(optional)</span></label>
            <div class="control">
                <input class="input is-small" type="text" name="notes" placeholder="Reason for the visit...">
            </div>
        </div>
    </form>
</div>
{% endif %}

<div class="mt-5">
    <a class="button is-light" href="/appointments">
        <i class="fas fa-arrow-left mr-1"></i>Back to Appointments
    </a>
    <a class="button is-primary" href="/appointments/book">
        <i class="fas fa-plus mr-1"></i>Book Appointment
    </a>
</div>
{% endblock %}
