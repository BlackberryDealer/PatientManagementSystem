{% extends "base.html.tera" %}
{% import "shared/macros.html.tera" as macros %}

{% block content %}
<div class="level">
    <div class="level-left">
        <div>
            <h1 class="title"><i class="fas fa-calendar-check mr-2"></i>Appointments</h1>
            <p class="subtitle is-6 has-text-grey">
                {% if user.role == "patient" %}Your upcoming and past appointments
                {% elif user.role == "doctor" %}Your patient schedule
                {% else %}All scheduled appointments in the system{% endif %}
            </p>
        </div>
    </div>
    <div class="level-right">
        <div class="buttons">
            <p class="button is-static has-text-grey"><i class="fas fa-list mr-1"></i>{{ appointments | length }}</p>
            {% if user.role == "doctor" or user.role == "admin" %}
            <a class="button is-info is-light" href="/appointments/waitlist"><i class="fas fa-list-ol mr-1"></i>Waitlist</a>
            {% endif %}
            <a class="button is-primary" href="/appointments/book"><i class="fas fa-plus mr-1"></i>Book Appointment</a>
        </div>
    </div>
</div>

{% if date_filter %}
<div class="notification is-info is-light py-3">
    <i class="fas fa-filter mr-1"></i>Showing appointments for <strong>{{ date_filter }}</strong>
    &nbsp;<a href="/appointments">Clear filter</a>
</div>
{% endif %}

{% if appointments %}
<div class="table-container fade-in">
    <table class="table is-fullwidth is-striped is-hoverable">
        <thead>
            <tr>
                <th><abbr title="Appointment ID">#</abbr></th>
                {% if user.role == "admin" %}<th>Patient</th>{% endif %}
                {% if user.role == "admin" or user.role == "patient" %}<th>Doctor</th>{% endif %}
                {% if user.role == "doctor" %}<th>Patient</th>{% endif %}
                <th><i class="fas fa-calendar-alt mr-1"></i>Date</th>
                <th><i class="fas fa-clock mr-1"></i>Time</th>
                <th>Room</th>
                <th>Priority</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for a in appointments %}
            <tr>
                <td class="has-text-grey is-size-7">#{{ a.id }}</td>
                {% if user.role == "admin" %}
                <td><i class="fas fa-user has-text-grey mr-1"></i>{{ a.patient_name }}</td>
                {% endif %}
                {% if user.role == "admin" or user.role == "patient" %}
                <td><i class="fas fa-stethoscope has-text-grey mr-1"></i>{{ a.doctor_name }}</td>
                {% endif %}
                {% if user.role == "doctor" %}
                <td><i class="fas fa-user has-text-grey mr-1"></i>{{ a.patient_name }}</td>
                {% endif %}
                <td><strong>{{ a.appointment_date }}</strong></td>
                <td>{{ a.start_time }} – {{ a.end_time }}</td>
                <td>
                    {% if a.room_name %}
                    <span class="tag is-light"><i class="fas fa-door-open mr-1"></i>{{ a.room_name }}</span>
                    {% else %}
                    <span class="tag is-warning is-light"><i class="fas fa-hourglass-half mr-1"></i>Pending Room Location</span>
                    {% endif %}
                </td>
                <td>
                    {% if a.priority == 1 %}
                    <span class="tag is-danger is-light"><i class="fas fa-ambulance mr-1"></i>Emergency</span>
                    {% elif a.priority == 2 %}
                    <span class="tag is-warning is-light"><i class="fas fa-exclamation-triangle mr-1"></i>Urgent</span>
                    {% elif a.priority == 4 %}
                    <span class="tag is-success is-light">Follow-up</span>
                    {% else %}
                    <span class="tag is-info is-light">Normal</span>
                    {% endif %}
                </td>
                <td>{{ macros::appointment_status_tag(status=a.status) }}</td>
                <td>
                    <div class="buttons are-small">
                        <a class="button is-info is-light" href="/appointments/{{ a.id }}">
                            <i class="fas fa-eye mr-1"></i>View
                        </a>
                        {% if a.status == "scheduled" %}
                        <form method="POST" action="/appointments/{{ a.id }}/cancel" style="display:inline;">
                            <button class="button is-danger is-light" type="submit" onclick="return confirm('Cancel appointment #{{ a.id }}? This cannot be undone.')">
                                <i class="fas fa-ban mr-1"></i>Cancel
                            </button>
                        </form>
                        {% endif %}
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
    {% if user.role == "patient" %}
        {{ macros::empty_state(icon="fa-calendar-times", title="No Appointments Yet", subtitle="Book your first appointment to see it here.", action_href="/appointments/book", action_label="Book Appointment") }}
    {% elif user.role == "doctor" %}
        {{ macros::empty_state(icon="fa-calendar-times", title="No Appointments Yet", subtitle="No patients have booked with you yet.", action_href="/appointments/book", action_label="Book Appointment") }}
    {% else %}
        {{ macros::empty_state(icon="fa-calendar-times", title="No Appointments Yet", subtitle="Appointments will appear here once created.", action_href="/appointments/book", action_label="Book Appointment") }}
    {% endif %}
{% endif %}
{% endblock %}
