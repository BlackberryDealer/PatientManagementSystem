{% extends "base.html.tera" %}
{% import "shared/macros.html.tera" as macros %}

{% block content %}
<nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li><a href="/users/{{ profile_user.id }}"><i class="fas fa-user mr-1"></i>{{ profile_user.username }}</a></li>
        <li class="is-active"><a href="#" aria-current="page">Change Password</a></li>
    </ul>
</nav>

<h1 class="title"><i class="fas fa-key mr-2"></i>Change Password</h1>
<p class="subtitle is-6 has-text-grey mb-5">
    {% if user.user_id == profile_user.id %}
    Update your account password.
    {% else %}
    Reset the password for {{ profile_user.full_name }}.
    {% endif %}
</p>

<div class="columns is-centered">
    <div class="column is-6">
        <div class="box fade-in">
            {% if error %}{{ macros::inline_error(error=error) }}{% endif %}

            <form method="POST" action="/users/{{ profile_user.id }}/change-password">
                {% if user.user_id == profile_user.id %}
                <div class="field">
                    <label class="label">Current Password</label>
                    <div class="control has-icons-left">
                        <input class="input" type="password" name="current_password" required autofocus>
                        <span class="icon is-small is-left"><i class="fas fa-lock"></i></span>
                    </div>
                </div>
                {% else %}
                <input type="hidden" name="current_password" value="">
                <p class="help mb-4">You are an admin resetting this account's password, so the current one is not required.</p>
                {% endif %}
                <div class="field">
                    <label class="label">New Password</label>
                    <div class="control has-icons-left">
                        <input class="input" type="password" name="new_password" minlength="8" required>
                        <span class="icon is-small is-left"><i class="fas fa-key"></i></span>
                    </div>
                    <p class="help">At least 8 characters.</p>
                </div>
                <div class="field">
                    <label class="label">Confirm New Password</label>
                    <div class="control has-icons-left">
                        <input class="input" type="password" name="confirm_password" minlength="8" required>
                        <span class="icon is-small is-left"><i class="fas fa-key"></i></span>
                    </div>
                </div>

                <hr>
                <div class="field is-grouped">
                    <div class="control">
                        <button class="button is-primary is-medium" type="submit">
                            <i class="fas fa-save mr-1"></i>Update Password
                        </button>
                    </div>
                    <div class="control">
                        <a class="button is-light is-medium" href="/users/{{ profile_user.id }}">
                            <i class="fas fa-times mr-1"></i>Cancel
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
