{% extends "base.html.tera" %}

{% block content %}
<div class="level">
    <div class="level-left">
        <div>
            <h1 class="title"><i class="fas fa-users mr-2"></i>All Users</h1>
            <p class="subtitle is-6 has-text-grey">Manage system accounts and permissions</p>
        </div>
    </div>
    <div class="level-right">
        <p class="has-text-grey"><i class="fas fa-database mr-1"></i>{{ users | length }} user(s)</p>
    </div>
</div>

{% if users %}
<div class="table-container fade-in">
    <table class="table is-fullwidth is-striped is-hoverable">
        <thead>
            <tr>
                <th><abbr title="User ID">#</abbr></th>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Joined</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for u in users %}
            <tr>
                <td class="has-text-grey is-size-7">#{{ u.id }}</td>
                <td><strong>{{ u.username }}</strong></td>
                <td>{{ u.full_name }}</td>
                <td class="is-size-7">{{ u.email }}</td>
                <td>
                    <span class="tag
                        {% if u.role == 'admin' %}is-danger
                        {% elif u.role == 'doctor' %}is-info
                        {% else %}is-success{% endif %} is-light" style="text-transform: capitalize;">
                        <i class="fas
                            {% if u.role == 'admin' %}fa-shield-alt
                            {% elif u.role == 'doctor' %}fa-stethoscope
                            {% else %}fa-user{% endif %} mr-1"></i>
                        {{ u.role }}
                    </span>
                </td>
                <td class="is-size-7 has-text-grey">{{ u.created_at }}</td>
                <td>
                    <a class="button is-small is-info is-light" href="/users/{{ u.id }}">
                        <i class="fas fa-eye mr-1"></i>View
                    </a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
<div class="hero is-medium has-text-centered has-text-grey fade-in">
    <div class="hero-body">
        <span class="icon is-large has-text-grey-lighter"><i class="fas fa-users-slash fa-4x"></i></span>
        <p class="title is-4 has-text-grey mt-4">No Users Found</p>
        <p class="subtitle is-6">Register the first user to get started.</p>
    </div>
</div>
{% endif %}
{% endblock %}
