{% extends "base.html.tera" %}
{% import "shared/macros.html.tera" as macros %}

{% block content %}
<div class="level">
    <div class="level-left">
        <div>
            <h1 class="title"><i class="fas fa-users mr-2"></i>All Users</h1>
            <p class="subtitle is-6 has-text-grey">Manage system accounts and permissions</p>
        </div>
    </div>
    <div class="level-right">
        <p class="has-text-grey"><i class="fas fa-database mr-1"></i>{{ users | length }} user(s)</p>
    </div>
</div>

{% if users %}
<div class="table-container fade-in">
    <table class="table is-fullwidth is-striped is-hoverable">
        <thead>
            <tr>
                <th><abbr title="User ID">#</abbr></th>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Joined</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for u in users %}
            <tr>
                <td class="has-text-grey is-size-7">#{{ u.id }}</td>
                <td><strong>{{ u.username }}</strong></td>
                <td>{{ u.full_name }}</td>
                <td class="is-size-7">{{ u.email }}</td>
                <td>{{ macros::user_role_tag(role=u.role) }}</td>
                <td class="is-size-7 has-text-grey">{{ u.created_at }}</td>
                <td>
                    <div class="buttons are-small">
                        <a class="button is-info is-light" href="/users/{{ u.id }}">
                            <i class="fas fa-eye mr-1"></i>View
                        </a>
                        {% if u.id != user.user_id %}
                        <form method="POST" action="/users/{{ u.id }}/delete"
                              onsubmit="return confirm('Permanently delete {{ u.full_name }}&#39;s account? This cannot be undone. Accounts with existing appointments, records, invoices, or waitlist entries cannot be deleted until that history is resolved.');">
                            <button class="button is-danger is-light" type="submit" title="Delete this account" aria-label="Delete this account">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                        {% endif %}
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
    {{ macros::empty_state(icon="fa-users-slash", title="No Users Found", subtitle="Register the first user to get started.") }}
{% endif %}
{% endblock %}
