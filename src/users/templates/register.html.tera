{% extends "base.html.tera" %}
{% import "shared/macros.html.tera" as macros %}

{% block content %}
<div class="columns is-centered mt-5">
    <div class="column is-5">
        <div class="box p-6 fade-in">
            <div class="has-text-centered mb-5">
                <span class="icon is-large has-text-primary">
                    <i class="fas fa-user-plus fa-3x"></i>
                </span>
                <h1 class="title mt-3">Create Account</h1>
                <p class="subtitle is-6 has-text-grey">Join the Patient Management System</p>
            </div>

            {% if error %}{{ macros::inline_error(error=error) }}{% endif %}

            <form method="POST" action="/users/register">
                <div class="field">
                    <label class="label"><i class="fas fa-id-badge mr-1"></i>Full Name</label>
                    <div class="control has-icons-left">
                        <input class="input" type="text" name="full_name" placeholder="John Doe" value="{{ full_name | default(value='') }}" required>
                        <span class="icon is-small is-left"><i class="fas fa-id-badge"></i></span>
                    </div>
                </div>

                <div class="field">
                    <label class="label"><i class="fas fa-user mr-1"></i>Username</label>
                    <div class="control has-icons-left">
                        <input class="input" type="text" name="username" placeholder="johndoe" value="{{ username | default(value='') }}" required>
                        <span class="icon is-small is-left"><i class="fas fa-at"></i></span>
                    </div>
                </div>

                <div class="field">
                    <label class="label"><i class="fas fa-envelope mr-1"></i>Email</label>
                    <div class="control has-icons-left">
                        <input class="input" type="email" name="email" placeholder="john@example.com" value="{{ email | default(value='') }}" required>
                        <span class="icon is-small is-left"><i class="fas fa-envelope"></i></span>
                    </div>
                </div>

                <div class="field">
                    <label class="label"><i class="fas fa-lock mr-1"></i>Password</label>
                    <div class="control has-icons-left">
                        <input class="input" type="password" name="password" placeholder="Min. 8 characters" required minlength="8">
                        <span class="icon is-small is-left"><i class="fas fa-key"></i></span>
                    </div>
                    <p class="help">Must be at least 8 characters. Use a mix of letters, numbers, and symbols.</p>
                </div>

                <!-- Public sign-up always creates a Patient account. Doctor and
                     admin accounts are created by an administrator, so the role
                     is fixed here (and enforced again on the server). -->
                <input type="hidden" name="role" value="patient">
                <div class="field">
                    <label class="label"><i class="fas fa-user-tag mr-1"></i>Account Type</label>
                    <div class="notification is-info is-light py-3">
                        <i class="fas fa-user-injured mr-1"></i>
                        You are registering as a <strong>Patient</strong>. Clinic staff accounts
                        are set up by an administrator.
                    </div>
                </div>

                <div class="field mt-5">
                    <div class="control">
                        <button class="button is-primary is-medium is-fullwidth" type="submit">
                            <i class="fas fa-user-check mr-2"></i>Create Account
                        </button>
                    </div>
                </div>
            </form>

            <div class="has-text-centered mt-4">
                <p class="has-text-grey">
                    Already have an account?
                    <a class="has-text-weight-bold" href="/users/login">Login here</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
