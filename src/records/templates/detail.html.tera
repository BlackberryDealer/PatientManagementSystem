{% extends "base.html.tera" %}

{% block content %}
<nav class="breadcrumb" aria-label="breadcrumbs">
    <ul>
        <li><a href="/records"><i class="fas fa-notes-medical mr-1"></i>Medical Records</a></li>
        <li class="is-active"><a href="#" aria-current="page">#{{ record.id }}</a></li>
    </ul>
</nav>

<div class="box fade-in">
    <h1 class="title mb-1">Medical Record #{{ record.id }}</h1>
    <p class="subtitle is-6 has-text-grey">{{ record.created_at }}</p>

    <div class="tags mb-5">
        <span class="tag is-success is-light"><i class="fas fa-user mr-1"></i>Patient #{{ record.patient_id }}</span>
        <span class="tag is-info is-light"><i class="fas fa-user-md mr-1"></i>Dr. #{{ record.doctor_id }}</span>
        {% if record.appointment_id %}
        <a class="tag is-link is-light" href="/appointments/{{ record.appointment_id }}">
            <i class="fas fa-calendar-check mr-1"></i>Appointment #{{ record.appointment_id }}
        </a>
        {% endif %}
    </div>

    <div class="card mt-4">
        <header class="card-header has-background-danger-light">
            <p class="card-header-title">
                <i class="fas fa-stethoscope mr-2"></i>Diagnosis
            </p>
        </header>
        <div class="card-content">
            <div class="content">
                {{ record.diagnosis | default(value="<em class='has-text-grey'>Not specified</em>") }}
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <header class="card-header has-background-success-light">
            <p class="card-header-title">
                <i class="fas fa-procedures mr-2"></i>Treatment Plan
            </p>
        </header>
        <div class="card-content">
            <div class="content">
                {{ record.treatment | default(value="<em class='has-text-grey'>Not specified</em>") }}
            </div>
        </div>
    </div>

    {% if record.notes %}
    <div class="card mt-4">
        <header class="card-header has-background-warning-light">
            <p class="card-header-title">
                <i class="fas fa-pencil-alt mr-2"></i>Additional Notes
            </p>
        </header>
        <div class="card-content">
            <div class="content">
                {{ record.notes }}
            </div>
        </div>
    </div>
    {% endif %}

    <div class="mt-5 buttons">
        <a class="button is-light is-medium" href="/records">
            <i class="fas fa-arrow-left mr-1"></i>Back to Records
        </a>
        <a class="button is-primary is-medium" href="/records/{{ record.id }}/report">
            <i class="fas fa-file-medical-alt mr-1"></i>Generate Report
        </a>
        {% if user.role == "doctor" or user.role == "admin" %}
        <a class="button is-link is-light is-medium" href="/records/timeline?patient_id={{ record.patient_id }}">
            <i class="fas fa-stream mr-1"></i>Patient Timeline
        </a>
        {% endif %}
    </div>
</div>
{% endblock %}
