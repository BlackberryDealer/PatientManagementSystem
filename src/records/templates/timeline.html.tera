{% extends "base.html.tera" %}
{% import "shared/macros.html.tera" as macros %}

{% block head_extra %}
<style>
    /* The vertical connecting line and marker offset for the timeline layout
       below, page-specific so they live here rather than in the shared
       base stylesheet. */
    .timeline-rail { border-left: 3px solid #dbdbdb; margin-left: 1rem; padding-left: 0; }
    .timeline-entry { margin-left: -1.05rem; }
    .timeline-card { flex: 1; }
</style>
{% endblock %}

{% block content %}
<div class="level">
    <div class="level-left">
        <div>
            <h1 class="title"><i class="fas fa-stream mr-2"></i>Patient History Timeline</h1>
            <p class="subtitle is-6 has-text-grey">
                Complete chronological history for <strong>{{ patient_name }}</strong> —
                appointments, diagnoses, prescriptions, and billing
            </p>
        </div>
    </div>
    <div class="level-right">
        <p class="button is-static has-text-grey"><i class="fas fa-history mr-1"></i>{{ events | length }} events</p>
    </div>
</div>

{% if events %}
<div class="fade-in timeline-rail">
    {% for e in events %}
    <div class="is-flex mb-4 timeline-entry">
        <div class="mr-4">
            <span class="icon is-medium has-text-{{ e.color }} has-background-white">
                <i class="fas {{ e.icon }} fa-lg"></i>
            </span>
        </div>
        <div class="box py-3 px-4 timeline-card">
            <div class="is-flex is-justify-content-space-between is-align-items-center mb-1">
                <p class="has-text-weight-semibold">{{ e.title }}</p>
                <span class="tag is-light is-size-7"><i class="fas fa-clock mr-1"></i>{{ e.when }}</span>
            </div>
            <p class="is-size-7 has-text-grey">{{ e.summary }}</p>
            {% if e.link %}
            <a class="is-size-7" href="{{ e.link }}"><i class="fas fa-arrow-right mr-1"></i>View details</a>
            {% endif %}
        </div>
    </div>
    {% endfor %}
</div>
{% else %}
    {{ macros::empty_state(icon="fa-stream", title="No History Yet", subtitle="Appointments, records, prescriptions, and invoices will appear here chronologically.") }}
{% endif %}
{% endblock %}
